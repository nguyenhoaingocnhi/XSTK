    "print(f\"Độ lệch chuẩn mẫu (s)     : {s:.2f}\")\n",
    "print(f\"Giá trị t_(24; 0.025)     : {t_alpha_2:.4f}\")\n",
    "print(f\"Sai số                    : {sai_so:.2f}\")\n",
    "print(f\"Khoảng tin cậy 95% của mu : ({x_tb - sai_so:.2f} < mu < {x_tb + sai_so:.2f})\")\n",
    "\n",
    "# 5. Vẽ biểu đồ\n",
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "# Biểu đồ 1: Biểu đồ hình chuông giống Hình 5.3 trong sách\n",
    "ax1 = plt.subplot(1, 2, 1)\n",
    "\n",
    "# 1. Tạo dữ liệu trục t và tính y một lần\n",
    "t_val = np.linspace(-4, 4, 400)\n",
    "y_val = t.pdf(t_val, df=n-1)\n",
    "y_t = t.pdf(t_alpha_2, df=n-1) # Tính trước giá trị y tại điểm tới hạn để tái sử dụng\n",
    "\n",
    "# 2. Vẽ đường cong và trục ngang\n",
    "plt.plot(t_val, y_val, color='black', lw=1.2)\n",
    "plt.axhline(0, color='black', lw=1)\n",
    "\n",
    "# 3. Gộp 3 đường thẳng đứng (trục giữa, biên trái, biên phải) vào 1 lệnh duy nhất\n",
    "plt.vlines([0, -t_alpha_2, t_alpha_2], 0, [t.pdf(0, df=n-1) + 0.03, y_t, y_t], color='black', lw=1)\n",
    "\n",
    "# 4. Gộp 2 vùng gạch chéo bằng điều kiện trị tuyệt đối (do đồ thị đối xứng)\n",
    "plt.fill_between(t_val, 0, y_val, where=(np.abs(t_val) >= t_alpha_2), facecolor='none', edgecolor='black', hatch='///')\n",
    "\n",
    "# 5. Ghi chú và căn chỉnh trục\n",
    "plt.text(-t_alpha_2 - 0.5, 0.04, r'$\\frac{\\alpha}{2}$', fontsize=12, ha='center')\n",
    "plt.text(t_alpha_2 + 0.5, 0.04, r'$\\frac{\\alpha}{2}$', fontsize=12, ha='center')\n",
    "plt.xticks([-t_alpha_2, 0, t_alpha_2], [r'$-t_{n-1;\\frac{\\alpha}{2}}$', '0', r'$t_{n-1;\\frac{\\alpha}{2}}$'], fontsize=11)\n",
    "plt.yticks([]) \n",
    "ax1.spines['bottom'].set_visible(False)\n",
    "plt.ylim(-0.02, 0.45)\n",
    "plt.title('Biểu đồ hình chuông (Hình 5.3)')\n",
    "\n",
